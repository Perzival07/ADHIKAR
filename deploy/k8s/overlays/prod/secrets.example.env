# Required secrets for the prod overlay (create them with your secret manager; never commit real values)
#
# secret: auth-secrets
AUTH_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@your-managed-postgres:5432/auth
AUTH_JWT_PRIVATE_KEY=<EC P-256 PEM: python -m auth_service gen-key>
AUTH_OTP_SECRET=<random, at least 32 characters>
AUTH_SMTP_HOST=<smtp host>
AUTH_SMTP_USERNAME=<smtp user>
AUTH_SMTP_PASSWORD=<smtp password>
AUTH_SMTP_FROM=Haqdaar <no-reply@your-domain>
#
# secret: reco-secrets
RECO_ADMIN_TOKEN=<random>
RECO_METRICS_TOKEN=<random>
#
# secret: haqdaar-shared
REDIS_URL=redis://redis:6379/0
REDIS_URL_AUTH=redis://redis:6379/1
