{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Haqdaar eligibility rule files",
  "definitions": {
    "outcome": {
      "type": "object",
      "required": ["status", "score", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "when": {"type": "object"},
        "status": {"enum": ["eligible", "ineligible", "unknown"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "minLength": 1},
        "missing_fields": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["version", "schemes"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "schemes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["outcomes"],
            "additionalProperties": false,
            "properties": {
              "outcomes": {"type": "array", "items": {"$ref": "#/definitions/outcome", "required": ["when"]}},
              "default": {"$ref": "#/definitions/outcome"}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["version", "rules"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": 1},
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/outcome", "required": ["id"]}}
      }
    }
  ]
}
