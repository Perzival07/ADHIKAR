# ADHIKAR: there is no root .env.
# App settings are compile-time defines:   flutter run --dart-define=RAG_API_URL=http://localhost:8000 --dart-define=AUTH_API_URL=http://localhost:8006
# Backend settings are per service:        backend/services/<service>/.env.example  (prefixes RECO_, LLMGW_, EMBED_, INGEST_, RETRIEVAL_, ELIG_, AUTH_)
# Compose-level variables (optional):      backend/.env  with POSTGRES_PASSWORD, RECO_AUTH_MODE, RECO_ADMIN_TOKEN, EMBED_PROVIDER
